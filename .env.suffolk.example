# Kaseya MDR (formerly RocketCyber) MCP (Suffolk). Read by: node --env-file=.env dist/entry.js
# install-service.ps1 creates .env from this file and fills in MCP_BEARER_TOKEN.

# API key: Kaseya MDR (RocketCyber) console > Provider Settings > API tab
# (sent as "Authorization: Bearer <key>" to api-us.rocketcyber.com/v3)
ROCKETCYBER_API_KEY=
# us (api-us.rocketcyber.com) or eu (api-eu.rocketcyber.com)
ROCKETCYBER_REGION=us

# HTTP transport for the Cloudflare MCP portal
MCP_TRANSPORT=http
MCP_HTTP_HOST=0.0.0.0
MCP_HTTP_PORT=8772

# Required on every /mcp request as "Authorization: Bearer <token>" (generated by the installer)
MCP_BEARER_TOKEN=

# Name the server reports to MCP clients
MCP_SERVER_NAME=kaseya-mdr-mcp

LOG_LEVEL=info

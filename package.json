{
  "name": "@wyre-ai/rocketcyber-mcp",
  "version": "1.1.7",
  "description": "MCP (Model Context Protocol) server for RocketCyber Managed SOC platform",
  "main": "dist/entry.js",
  "bin": {
    "rocketcyber-mcp": "./dist/entry.js"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/entry.js",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "prepare": "npm run build",
    "prebuild": "npm run clean",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "rocketcyber",
    "managed-soc",
    "cybersecurity",
    "api",
    "typescript",
    "nodejs"
  ],
  "author": "Aaron Sachs",
  "license": "Apache-2.0",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@wyre-technology/node-rocketcyber": "file:vendor/wyre-technology-node-rocketcyber-1.1.3.tgz",
    "winston": "^3.11.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@types/node": "^26.2.0",
    "semantic-release": "^25.0.9",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
